 # MR label that triggers AI review (MRs must have this label to be reviewed)
 REVIEW_TRIGGER_LABEL=ai-review
 
+# Output token cap for each structured-review call. Raise it if reviews fail
+# with "cut off mid-JSON": the model ran out of budget before finishing the
+# JSON. Reasoning models spend thinking tokens from this same budget and need
+# considerably more than 8192.
+REVIEW_STRUCTURED_MAX_TOKENS=8192
+
 # AI response language for GitLab comments/replies (en | vi | ja)
 AI_RESPONSE_LANGUAGE=en
 
