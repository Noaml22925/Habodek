# Habodek v2 — the control plane's settings (docker/compose.yml reads this file).
# Every variable is described in agent/README.md. Paths default to /var/lib/habodek/*
# inside the image; the store, sandbox image and path map are set by compose.yml.

# --- GitLab (the token stays in the control plane; the brain never sees it) ---
GITLAB_BASE_URL=https://gitlab.example.internal
GITLAB_TOKEN=glpat-FILL-ME
GITLAB_WEBHOOK_SECRET=FILL-ME
GITLAB_BOT_USER_ID=0
REVIEW_TRIGGER_LABEL=ai-review

# --- The LiteLLM gateway (the key stays in the control plane's proxy) ---
HABODEK_GATEWAY_URL=https://litellm.example.internal/v1
HABODEK_GATEWAY_KEY=FILL-ME
HABODEK_GATEWAY_RPM=25
# The two models' aliases on the gateway (the M1 probe prints what it found):
HABODEK_MODEL_QWEN=qwen3.8-flash-next
HABODEK_MODEL_GLM=glm-5.3-flash

# --- Internal Python packages and where their source comes from (Artifactory) ---
HABODEK_INTERNAL_PACKAGES=
HABODEK_PIP_INDEX_URL=https://artifactory.example.internal/api/pypi/pypi/simple

# --- Sandbox (runs repository code; HABODEK_SANDBOX=docker is set by compose.yml) ---
# The Docker network env-prep uses to reach Artifactory; runs always get --network none.
HABODEK_SANDBOX_PREP_NETWORK=bridge
HABODEK_SANDBOX_MEMORY_MB=4096
HABODEK_SANDBOX_CPUS=2

# --- Throughput ---
WORKER_POOL_SIZE=3
HABODEK_MAX_COMMENTS=6

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
