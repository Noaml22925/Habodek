# Habodek v2 control plane, run directly on a host (go run ./cmd/server).
# For the Docker deployment use docker/habodek.env.example instead.
# Every variable is described in agent/README.md.

# --- Server and store ---
SERVER_PORT=8080
STORE_DRIVER=sqlite
SQLITE_PATH=data/habodek.db
# STORE_DRIVER=postgres
# DATABASE_URL=postgres://habodek:password@localhost:5432/habodek?sslmode=disable

# --- GitLab ---
GITLAB_BASE_URL=https://gitlab.example.internal
GITLAB_TOKEN=glpat-FILL-ME
GITLAB_WEBHOOK_SECRET=FILL-ME
GITLAB_BOT_USER_ID=0
REVIEW_TRIGGER_LABEL=ai-review
GIT_REPOS_DIR=data/repos

# --- The LiteLLM gateway ---
HABODEK_GATEWAY_URL=https://litellm.example.internal/v1
HABODEK_GATEWAY_KEY=FILL-ME
HABODEK_GATEWAY_RPM=25
HABODEK_MODEL_QWEN=qwen3.8-flash-next
HABODEK_MODEL_GLM=glm-5.3-flash

# --- The brain ---
HABODEK_BRAIN_CMD=habodek-brain
HABODEK_WORK_DIR=data/jobs
HABODEK_TRACE_DIR=data/traces
HABODEK_INTERNAL_PACKAGES=
HABODEK_PIP_INDEX_URL=
HABODEK_MAX_COMMENTS=6
WORKER_POOL_SIZE=3

# --- Memory, sandbox, bars ---
HABODEK_MEMORY_DIR=data/memory
HABODEK_SANDBOX=local
HABODEK_SANDBOX_CACHE=data/sandbox
HABODEK_BARS=on

LOG_LEVEL=info
LOG_FORMAT=text
